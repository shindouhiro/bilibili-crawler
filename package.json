{
  "name": "bilibili-crawler-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:desktop": "pnpm --filter @crawler/desktop dev",
    "dev:api": "pnpm --filter @crawler/server dev",
    "dev:start": "concurrently -k -n API,WEB -c cyan,blue \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @crawler/web dev",
    "build:android": "pnpm --filter @crawler/desktop build:android",
    "build:desktop": "pnpm --filter @crawler/desktop build",
    "build:web": "pnpm --filter @crawler/web build",
    "lint": "pnpm --filter @crawler/web lint",
    "release": "bumpp package.json apps/*/package.json apps/desktop/src-tauri/tauri.conf.json --commit \"chore: release v%s\" --tag --push",
    "tauri": "tauri"
  },
  "devDependencies": {
    "bumpp": "^11.0.1",
    "concurrently": "^9.2.1"
  }
}
